# Copy to .env.local and adjust.

# Base URL of the TDaaS API. Leave empty to call the same origin (use the dev proxy below).
VITE_API_BASE_URL=

# Endpoint paths (relative to VITE_API_BASE_URL).
VITE_HEALTH_PATH=/health-check
VITE_WORKFLOWS_PATH=/workflows
VITE_RETRIEVE_PATH=/retrieve
VITE_SUGGEST_PROMPTS_PATH=/suggest-prompts

# Where "Open Jira" sends people (e.g. the create-issue page of your project).
VITE_JIRA_URL=

# true = use built-in sample data instead of a real backend (for demos and UI work).
VITE_USE_MOCKS=false

# Dev server only: forward API calls to this backend to avoid CORS during development.
# When set, leave VITE_API_BASE_URL empty.
TDAAS_PROXY_TARGET=
